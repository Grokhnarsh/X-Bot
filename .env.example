# =============================================================================
#  X-Bot - Zugangsdaten
#  Kopieren nach ".env" und ausfuellen.  Die .env-Datei ist gitignored.
# =============================================================================

# -----------------------------------------------------------------------------
# X (Twitter) API v2 - https://developer.x.com/en/portal/dashboard
#
# 1. App im Developer Portal anlegen
# 2. User authentication settings -> App permissions: "Read and write"
#    (ohne Schreibrechte kann der Bot nicht posten/liken/reposten)
# 3. Type of App: "Web App, Automated App or Bot"
# 4. Keys and tokens -> alle vier Werte unten erzeugen
#
# WICHTIG: Nach dem Umstellen der Permissions muessen Access Token und Secret
# NEU generiert werden, sonst bleiben sie read-only.
# -----------------------------------------------------------------------------
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

# Bearer Token (App-only). Wird fuer die Hashtag-Suche genutzt.
X_BEARER_TOKEN=

# -----------------------------------------------------------------------------
# Claude API fuer die KI-Texterstellung (optional)
# Ohne Key nutzt der Bot automatisch die Templates aus content/templates.yaml.
# Key: https://console.anthropic.com/settings/keys
# -----------------------------------------------------------------------------
ANTHROPIC_API_KEY=

# -----------------------------------------------------------------------------
# Globaler Sicherheitsschalter.
# "true"  = nichts wird wirklich gesendet, alles nur geloggt (Standard)
# "false" = der Bot schreibt echt auf X
# Ueberschreibt bot.dry_run aus der config.yaml.
# -----------------------------------------------------------------------------
XBOT_DRY_RUN=true

# Pfad zur Konfigurationsdatei (optional)
# XBOT_CONFIG=config.yaml
